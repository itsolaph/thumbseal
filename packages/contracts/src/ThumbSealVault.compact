pragma language_version >= 0.20;

// ThumbSealVault â€” Flagship Walletless Anonymous Passkey Registry & Scoped Action Vault
// Licensed under the Apache License, Version 2.0.
//
// k=17 Optimized Architecture:
// - registerPasskey():       k=15 (56 MB prover key)
// - authorizeAction():       k=17 (224 MB prover key â€” standard W3C Chrome/Firefox/Edge/Safari)
// - authorizeActionGrease(): k=17 (224 MB prover key â€” Chromium 20% GREASE auto-routed by SDK)
// - enrollBackupPasskey():   k=17 (224 MB prover key â€” anonymous biometric multi-device recovery)
//
// Privacy guarantees (enforced by Compact's static witness-disclosure checker):
// - Passkey public key (x, y) and blinding salt NEVER leave the client's local prover.
// - On authorizeAction(), authorizeActionGrease(), and enrollBackupPasskey(), keyCommit
//   is NEVER disclosed: membership is proven anonymously via HistoricMerkleTree<16>.
// - Nullifiers are domain- and scope-separated (replay reverts; cross-scope unlinkable).

import CompactStandardLibrary;
import "./PasskeyAuth" prefix PA_;

export { PA_WebAuthnAssertion };

export ledger rpIdHash: Bytes<32>;
export ledger origin: Bytes<27>;
export ledger defaultRequireUv: Boolean;
export ledger keyTree: HistoricMerkleTree<16, Bytes<32>>;
export ledger registeredKeys: Set<Bytes<32>>;
export ledger usedNullifiers: Set<Bytes<32>>;
export ledger receipts: Map<Bytes<32>, Bytes<32>>;
export ledger registeredCount: Counter;
export ledger authorizedCount: Counter;

witness localPasskeyPub(): Secp256r1Point;
witness localKeySalt(): Bytes<32>;
witness localKeyPath(): MerkleTreePath<16, Bytes<32>>;
witness localWebAuthnAssertion(): PA_WebAuthnAssertion;
witness localBackupPasskeyPub(): Secp256r1Point;
witness localBackupKeySalt(): Bytes<32>;

constructor(initRpIdHash: Bytes<32>, initOrigin: Bytes<27>, initRequireUv: Boolean) {
  rpIdHash = disclose(initRpIdHash);
  origin = disclose(initOrigin);
  defaultRequireUv = disclose(initRequireUv);
}

export circuit registerPasskey(): Bytes<32> {
  const pk: Secp256r1Point = localPasskeyPub();
  const salt: Bytes<32> = localKeySalt();
  const keyCommit: Bytes<32> = PA_commitPasskey(pk, salt);
  const pubCommit: Bytes<32> = disclose(keyCommit);

  assert(!registeredKeys.member(pubCommit), "Passkey commitment already registered");
  assert(!keyTree.isFull(), "Passkey registry is full");

  registeredKeys.insert(pubCommit);
  keyTree.insert(pubCommit);
  registeredCount.increment(1);
  return pubCommit;
}

// Standard W3C WebAuthn authorization (Chrome 80%, Firefox 100%, Edge 80%, Safari 15.4+ 100%).
export circuit authorizeAction(
  scopeId: Bytes<32>,
  actionTag: Bytes<32>,
  requireBiometric: Boolean
): Bytes<32> {
  const pk: Secp256r1Point = localPasskeyPub();
  const salt: Bytes<32> = localKeySalt();
  const path: MerkleTreePath<16, Bytes<32>> = localKeyPath();
  const assertion: PA_WebAuthnAssertion = localWebAuthnAssertion();

  const keyCommit: Bytes<32> = PA_commitPasskey(pk, salt);
  assert(path.leaf == keyCommit, "Merkle leaf does not match local passkey commitment");

  const root: MerkleTreeDigest = merkleTreePathRoot<16, Bytes<32>>(path);
  assert(keyTree.checkRoot(disclose(root)), "Invalid or unknown passkey registry root");

  const expectedChallenge: Bytes<32> = PA_deriveChallenge(
    "thumbseal:act:v1",
    rpIdHash,
    scopeId,
    actionTag
  );
  const enforceUv: Boolean = defaultRequireUv || requireBiometric;
  PA_verifyWebAuthnAssertion<27>(pk, rpIdHash, origin, expectedChallenge, enforceUv, assertion);

  const nullifier: Bytes<32> = PA_deriveScopedNullifier(keyCommit, rpIdHash, scopeId);
  const pubNullifier: Bytes<32> = disclose(nullifier);
  assert(!usedNullifiers.member(pubNullifier), "Nullifier already spent for this scope");

  usedNullifiers.insert(pubNullifier);
  receipts.insert(pubNullifier, disclose(actionTag));
  authorizedCount.increment(1);
  return pubNullifier;
}

// Chromium 20% GREASE authorization sharing the exact same HistoricMerkleTree and nullifier set.
export circuit authorizeActionGrease(
  scopeId: Bytes<32>,
  actionTag: Bytes<32>,
  requireBiometric: Boolean
): Bytes<32> {
  const pk: Secp256r1Point = localPasskeyPub();
  const salt: Bytes<32> = localKeySalt();
  const path: MerkleTreePath<16, Bytes<32>> = localKeyPath();
  const assertion: PA_WebAuthnAssertion = localWebAuthnAssertion();

  const keyCommit: Bytes<32> = PA_commitPasskey(pk, salt);
  assert(path.leaf == keyCommit, "Merkle leaf does not match local passkey commitment");

  const root: MerkleTreeDigest = merkleTreePathRoot<16, Bytes<32>>(path);
  assert(keyTree.checkRoot(disclose(root)), "Invalid or unknown passkey registry root");

  const expectedChallenge: Bytes<32> = PA_deriveChallenge(
    "thumbseal:act:v1",
    rpIdHash,
    scopeId,
    actionTag
  );
  const enforceUv: Boolean = defaultRequireUv || requireBiometric;
  PA_verifyWebAuthnAssertionGrease<27>(pk, rpIdHash, origin, expectedChallenge, enforceUv, assertion);

  const nullifier: Bytes<32> = PA_deriveScopedNullifier(keyCommit, rpIdHash, scopeId);
  const pubNullifier: Bytes<32> = disclose(nullifier);
  assert(!usedNullifiers.member(pubNullifier), "Nullifier already spent for this scope");

  usedNullifiers.insert(pubNullifier);
  receipts.insert(pubNullifier, disclose(actionTag));
  authorizedCount.increment(1);
  return pubNullifier;
}

// Anonymous biometric backup device enrollment (e.g. TouchID authorizes FaceID backup).
export circuit enrollBackupPasskey(scopeId: Bytes<32>): Bytes<32> {
  const pk: Secp256r1Point = localPasskeyPub();
  const salt: Bytes<32> = localKeySalt();
  const path: MerkleTreePath<16, Bytes<32>> = localKeyPath();
  const assertion: PA_WebAuthnAssertion = localWebAuthnAssertion();

  const backupPk: Secp256r1Point = localBackupPasskeyPub();
  const backupSalt: Bytes<32> = localBackupKeySalt();

  const keyCommit: Bytes<32> = PA_commitPasskey(pk, salt);
  assert(path.leaf == keyCommit, "Merkle leaf does not match authorizing passkey");

  const root: MerkleTreeDigest = merkleTreePathRoot<16, Bytes<32>>(path);
  assert(keyTree.checkRoot(disclose(root)), "Invalid or unknown passkey registry root");

  const backupCommit: Bytes<32> = PA_commitPasskey(backupPk, backupSalt);
  const pubBackupCommit: Bytes<32> = disclose(backupCommit);
  assert(!registeredKeys.member(pubBackupCommit), "Backup passkey commitment already registered");
  assert(!keyTree.isFull(), "Passkey registry is full");

  const expectedChallenge: Bytes<32> = PA_deriveChallenge(
    "thumbseal:bkp:v1",
    rpIdHash,
    scopeId,
    pubBackupCommit
  );
  PA_verifyWebAuthnAssertion<27>(pk, rpIdHash, origin, expectedChallenge, true, assertion);

  const nullifier: Bytes<32> = PA_deriveScopedNullifier(keyCommit, rpIdHash, scopeId);
  const pubNullifier: Bytes<32> = disclose(nullifier);
  assert(!usedNullifiers.member(pubNullifier), "Backup enrollment scope already spent");

  usedNullifiers.insert(pubNullifier);
  registeredKeys.insert(pubBackupCommit);
  keyTree.insert(pubBackupCommit);
  registeredCount.increment(1);
  return pubBackupCommit;
}
